# Embedded Python: link headers, libpython, and bake the venv prefix.
#
# Anchor the venv location off THIS file's path: makefrag is always at
# <project>/src/makefrag, so the venv is at ../.venv from this dir. That's
# robust to whatever directory `make` was invoked from (IDE, container
# build.sh, or bare `cd src && make`). UV_PROJECT_ENVIRONMENT overrides
# for non-standard layouts (e.g. container's sibling .venv).
#
# We deliberately do not consult $(VIRTUAL_ENV): OMNeT++'s setenv activates
# its own bundled scave venv (often Python 3.9) and exports VIRTUAL_ENV;
# picking that up would link the simulator against libpython3.9 instead
# of the project venv's libpython3.12.
VENV_PREFIX := $(if $(UV_PROJECT_ENVIRONMENT),$(UV_PROJECT_ENVIRONMENT),$(abspath $(dir $(lastword $(MAKEFILE_LIST)))/..)/.venv)
VENV_PYTHON := $(VENV_PREFIX)/bin/python3
ifeq ($(wildcard $(VENV_PYTHON)),)
  $(error PyBridge: venv not found at $(VENV_PREFIX). Run 'uv sync'.)
endif

# Sanity-check Python version matches pyproject.toml's requires-python.
# Catches the "stale .venv from a previous Python" case before linking against
# the wrong libpython and discovering it at runtime.
VENV_PY_MM := $(shell $(VENV_PYTHON) -c "import sys; print(f'{sys.version_info.major}.{sys.version_info.minor}')")
ifneq ($(VENV_PY_MM),3.12)
  $(error PyBridge: venv at $(VENV_PREFIX) is Python $(VENV_PY_MM); pyproject.toml requires 3.12. Recreate with 'rm -rf .venv && uv sync'.)
endif

PYTHON_INCLUDE := $(shell $(VENV_PYTHON) -c "import sysconfig; print(sysconfig.get_path('include'))")
PYTHON_LIBDIR  := $(shell $(VENV_PYTHON) -c "import sysconfig; print(sysconfig.get_config_var('LIBDIR'))")
PYTHON_LDLIB   := $(shell $(VENV_PYTHON) -c "import sysconfig; v=sysconfig.get_config_var('VERSION'); print(f'python{v}')")
PYBIND11_INCLUDE := $(shell $(VENV_PYTHON) -c "import pybind11; print(pybind11.get_include())")

COPTS += -I$(PYTHON_INCLUDE) -I$(PYBIND11_INCLUDE) -DVENV_PREFIX=$(VENV_PREFIX)
LIBS  += -L$(PYTHON_LIBDIR) -l$(PYTHON_LDLIB) -Wl,-rpath,$(PYTHON_LIBDIR)

# OSG libraries for 3D waypoint path visualization
LIBS += -losg -losgDB -lOpenThreads
